# Browser-visible API base URL. The local fallback is http://localhost:8080.
NEXT_PUBLIC_MEANDER_API_URL=http://localhost:8080
# Google Identity Services client ID. This is public by design; never put a
# Google client secret in browser-visible NEXT_PUBLIC_ variables.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Go API runtime settings.
PORT=8080
MEANDER_ALLOWED_ORIGINS=http://localhost:3000
MEANDER_OUTPUT=output
MEANDER_FIXTURES=fixtures
MEANDER_ENV=development
MEANDER_APP_URL=http://localhost:3000
MEANDER_API_URL=http://localhost:8080
MEANDER_GOOGLE_CLIENT_ID=
MEANDER_AUTH_LIMIT_15M=300
MEANDER_GENERATION_LIMIT_10M=6
MEANDER_GENERATION_IP_LIMIT_HOUR=300
MEANDER_DAILY_GENERATION_LIMIT=25
MEANDER_GENERATION_CONCURRENCY=1
# A randomly generated, server-only value used to hash rate-limit identifiers.
# Required in production. Generate with: openssl rand -hex 32
MEANDER_RATE_LIMIT_SALT=local-development-salt

# Vercel production only. The frontend calls /api at its own origin; Vercel
# rewrites those requests to this Cloud Run URL during the build.
# NEXT_PUBLIC_MEANDER_API_URL=same-origin
# MEANDER_BACKEND_ORIGIN=https://your-cloud-run-service.run.app

# Production persistence. When unset, the API uses local development storage.
# DATABASE_URL=postgresql://...
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=meander-artworks
